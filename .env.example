# ===================================================================
# Streak Environment Configuration
# ===================================================================

# -------------------------------------------------------------------
# Backend Configuration (FastAPI)
# -------------------------------------------------------------------
# PostgreSQL connection string (Supabase / Render)
# For local development / testing, SQLite can be used: sqlite:///./streak.db
# For Supabase with Transaction Pooler: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require

# Allowed origin for CORS (e.g. your Vercel deployment or local Next.js app)
FRONTEND_URL=http://localhost:3000

# Base start date for deterministic daily puzzle index calculation (YYYY-MM-DD)
PUZZLE_START_DATE=2026-08-14

# Canonical timezone for game day boundary (e.g. UTC, Asia/Kolkata)
GAME_TIMEZONE=Asia/Kolkata

# Environment (development, production, test)
ENVIRONMENT=development

# -------------------------------------------------------------------
# Frontend Configuration (Next.js)
# -------------------------------------------------------------------
# Base URL for the FastAPI backend API
NEXT_PUBLIC_API_URL=http://localhost:8001
